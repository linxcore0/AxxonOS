{
  "entities": {
    "pricing_config": {
      "title": "Pricing Configuration",
      "description": "Centralized real-time pricing configuration for plans and currency markup",
      "type": "object",
      "properties": {
        "prices": {
          "type": "object",
          "description": "Map of plan key to USD price number",
          "properties": {
            "starter": { "type": "number" },
            "basic": { "type": "number" },
            "spark": { "type": "number" },
            "super": { "type": "number" },
            "king": { "type": "number" },
            "ultra": { "type": "number" }
          }
        },
        "markup_percent": {
          "type": "number",
          "description": "Global currency conversion markup percentage"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["prices"]
    },
    "users": {
      "title": "User Account",
      "description": "User profile, plan subscription, allowances, and status",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "email_verified": { "type": "boolean" },
        "plan": { "type": "string" },
        "bot_allowance": { "type": "number" },
        "message_allowance": { "type": "number" },
        "plan_expires_at": { "type": "string" },
        "currency": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/pricing_config/{configId}": {
      "schema": "pricing_config",
      "description": "Global pricing configuration"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User accounts and permissions"
    }
  }
}
